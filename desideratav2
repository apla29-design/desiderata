        // Funció per duplicar de manera fàcil i ràpida qualsevol element o matèria existent
        async function duplicateSubject(id) {
            const subject = database.find(item => item.id === id);
            if (!subject) return;

            const duplicated = JSON.parse(JSON.stringify(subject));
            duplicated.id = subject.study + '_' + Date.now().toString();
            duplicated.group = subject.group + ' (Còpia)';
            duplicated.assignedTeacher = ''; // El duplicat surt inicialment disponible

            if (isFirebaseInitialized) {
                try {
                    const subjectDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'subjects', duplicated.id);
                    await setDoc(subjectDocRef, duplicated);
                } catch (error) {
                    console.error("Error duplicant el mòdul a Firebase:", error);
                }
            } else {
                database.push(duplicated);
                saveSubjectsLocally(); // <-- Desa el nou element duplicat de forma permanent al navegador!
                renderSubjectCards();
                updateSelectionDashboard();
                renderProposalsTable();
            }
        }

        // Funció per actualitzar directament el docent des de la graella XLS
        async function updateSubjectTeacher(id, teacherName) {
            const index = database.findIndex(item => item.id === id);
            if (index === -1) return;
            
            database[index].assignedTeacher = teacherName.trim();
            
            if (isFirebaseInitialized) {
                try {
                    const subjectDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'subjects', id);
                    await setDoc(subjectDocRef, database[index], { merge: true });
                } catch (error) {
                    console.error("Error actualitzant l'assignació directa a Firebase:", error);
                }
            } else {
                saveSubjectsLocally();
                renderSubjectCards();
                updateSelectionDashboard();
                renderProposalsTable();
            }
        }

