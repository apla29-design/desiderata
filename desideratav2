        async function saveSubject(e) {
            e.preventDefault();
            const id = document.getElementById('form-subject-id').value;
            const code = document.getElementById('form-code').value;
            const name = document.getElementById('form-name').value;
            const hours = parseInt(document.getElementById('form-hours').value);
            const study = document.getElementById('form-study-field').value;
            const course = parseInt(document.getElementById('form-course-field').value);
            const specialty = document.getElementById('form-specialty').value;
            const group = document.getElementById('form-group').value;
            const schedule = document.getElementById('form-schedule').value;
            const teacher = document.getElementById('form-teacher').value.trim();
            const benefitsText = document.getElementById('form-benefits').value;
            const benefits = benefitsText.split('\n').map(b => b.trim()).filter(b => b !== '');
            const dept = (study === 'coor') ? document.getElementById('form-dept').value : '';

            let studyNameMap = {
                ac: 'CFGM Activitats Comercials',
                mp: 'CFGS Màrqueting i Publicitat',
                ci: 'CFGS Comerç Internacional',
                tl: 'CFGS Transport i Logística',
                ga: 'CFGM Gestió Administrativa',
                af: 'CFGS Administració i Finances',
                coor: 'Coordinacions i Càrrecs'
            };
            const cycle = studyNameMap[study] || '';

            const targetId = id ? id : study + '_' + Date.now().toString();
            const subjectPayload = {
                id: targetId,
                code, name, hours, course, study, cycle, specialty, group, schedule,
                assignedTeacher: teacher,
                benefits,
                status: 'available',
                dept
            };

            if (isFirebaseInitialized) {
                try {
                    const subjectDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'subjects', targetId);
                    await setDoc(subjectDocRef, subjectPayload, { merge: true });
                } catch (error) {
                    console.error("Error al núvol:", error);
                }
            } else {
                if (id) {
                    const index = database.findIndex(item => item.id === id);
                    if (index !== -1) {
                        database[index] = subjectPayload;
                    }
                } else {
                    database.push(subjectPayload);
                }
                saveSubjectsLocally(); // <-- Guarda permanentment els canvis manuals fets pel coordinador localment!
                renderSubjectCards();
                updateSelectionDashboard();
                renderProposalsTable();
            }

            closeEditModal();
        }

