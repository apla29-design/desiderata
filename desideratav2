<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Desiderata - INS Jaume Mimó</title>
    <!-- Tailwind CSS per a un disseny impecable, net i corporatiu -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans per a una tipografia elegant -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Icones de Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }
        
        /* Efecte "globus/bombolla" premium per a les targetes */
        .globus-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid transparent;
        }
        
        .globus-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.08), 0 10px 10px -5px rgba(0, 0, 0, 0.03);
        }

        /* Ambient Glows per crear l'efecte de fons del Jaume Mimó */
        .glow-bg-1 {
            filter: blur(140px);
            opacity: 0.15;
            background: radial-gradient(circle, #4f46e5 0%, #1e1b4b 100%);
        }
        .glow-bg-2 {
            filter: blur(140px);
            opacity: 0.12;
            background: radial-gradient(circle, #10b981 0%, #064e3b 100%);
        }
        
        /* Personalització del scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 relative overflow-x-hidden pb-16">

    <!-- Fons decoratius de tipus "globus" de llum -->
    <div class="absolute top-10 left-10 w-96 h-96 rounded-full glow-bg-1 -z-10 pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-[500px] h-[500px] rounded-full glow-bg-2 -z-10 pointer-events-none"></div>

    <!-- Capçalera Principal -->
    <header class="border-b border-slate-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-50 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
                <div class="h-11 w-11 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-lg shadow-indigo-600/30 flex-shrink-0">
                    <i class="fa-solid fa-rectangle-list text-xl"></i>
                </div>
                <div class="min-w-0">
                    <h1 class="font-extrabold text-lg sm:text-xl tracking-tight text-slate-900 truncate">Desiderata INS Jaume Mimó</h1>
                </div>
            </div>
            
            <!-- Controls d'Edició i Perfil -->
            <div class="flex items-center gap-3 flex-shrink-0">
                <button onclick="handleEditModeClick()" id="edit-mode-toggle" class="flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 shadow-xs transition-all">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                    </span>
                    <span id="edit-toggle-text">Mode Coordinació</span>
                </button>
                
                <div onclick="openIdentityModal()" class="flex items-center gap-2.5 pl-3 border-l border-slate-200 cursor-pointer hover:opacity-85 transition-opacity" title="Canvia d'usuari docent">
                    <div class="text-right hidden md:block">
                        <p id="user-display-name" class="text-xs font-bold text-slate-800">Docent Convidat</p>
                        <p id="user-display-spec" class="text-[10px] text-slate-400 font-bold">Identifica't fent clic</p>
                    </div>
                    <div id="user-display-initials" class="h-10 w-10 rounded-full bg-indigo-100 border border-indigo-200 flex items-center justify-center text-indigo-700 font-extrabold text-xs shadow-xs flex-shrink-0">
                        DC
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
        
        <!-- Banner d'Estat: Mode Edició -->
        <div id="admin-banner" class="hidden bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-5 mb-6 flex-col items-stretch gap-4 shadow-sm animate-fadeIn">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <span class="p-2.5 bg-amber-500/10 rounded-xl text-amber-600">
                        <i class="fa-solid fa-wand-magic-sparkles text-lg"></i>
                    </span>
                    <div>
                        <h3 class="font-bold text-amber-950 text-sm">Panell de Coordinació Actiu (Protegit)</h3>
                        <p class="text-xs text-amber-800/90 mt-0.5">Com a coordinador, pots afegir nous mòduls, duplicar elements, editar requisits, exportar tries o vincular-ho a un Google Sheets.</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
                    <button onclick="exportToCSV()" class="px-3.5 py-2.5 text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl shadow-xs transition-colors flex items-center justify-center gap-1.5" title="Descarrega un fitxer CSV per carregar-lo a Google Sheets o Excel">
                        <i class="fa-solid fa-file-excel"></i> Exportar a Excel (CSV)
                    </button>
                    <button onclick="forceSyncDefaultDatabase()" class="px-3.5 py-2.5 text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white rounded-xl shadow-xs transition-colors flex items-center justify-center gap-1.5" title="Sincronitza totes les matèries dels excels d'origen directament al núvol de Firestore">
                        <i class="fa-solid fa-cloud-arrow-up"></i> Sincronitzar dades Excel
                    </button>
                    <button onclick="openAddModal()" class="px-3.5 py-2.5 text-xs font-bold bg-amber-600 hover:bg-amber-700 text-white rounded-xl shadow-xs transition-colors flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-plus"></i> Crear "Globus"
                    </button>
                </div>
            </div>
            
            <!-- Configuració de Google Webhook per al Drive del centre -->
            <div class="bg-white/80 border border-amber-200/60 rounded-xl p-3 mt-1">
                <div class="flex flex-col md:flex-row items-center justify-between gap-3">
                    <div class="flex items-center gap-2 min-w-0">
                        <i class="fa-brands fa-google-drive text-emerald-600 text-lg flex-shrink-0"></i>
                        <div class="min-w-0">
                            <h4 class="text-xs font-bold text-slate-800">Enllaç directe a Google Drive (Google Sheets)</h4>
                            <p class="text-[10px] text-slate-500 truncate">Vols que les respostes dels docents s'escriguin directament al teu de full de càlcul?</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 w-full md:w-auto md:max-w-md flex-grow justify-end">
                        <input type="text" id="sheets-webhook-url" onchange="saveSheetsWebhook()" placeholder="Enganxa la URL d'execució d'Apps Script del teu Drive..." class="w-full max-w-xs px-3 py-1.5 text-[11px] bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-indigo-500">
                        <button onclick="openSheetsGuide()" class="px-2.5 py-1.5 text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-100 hover:bg-indigo-100 rounded-lg transition-colors whitespace-nowrap">
                            <i class="fa-solid fa-circle-question"></i> Com es fa?
                        </button>
                    </div>
                </div>
            </div>

            <!-- Canviador de codi d'accés de Coordinació de l'institut -->
            <div class="bg-white/80 border border-amber-200/60 rounded-xl p-3 mt-1">
                <div class="flex flex-col md:flex-row items-center justify-between gap-3">
                    <div class="flex items-center gap-2 min-w-0">
                        <i class="fa-solid fa-shield-halved text-amber-600 text-lg flex-shrink-0"></i>
                        <div class="min-w-0">
                            <h4 class="text-xs font-bold text-slate-800">Seguretat: Canviar la Clau del Mode Coordinador</h4>
                            <p class="text-[10px] text-slate-500 truncate">Estableix una nova contrasenya d'accés per protegir el teu panell.</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 w-full md:w-auto justify-end">
                        <input type="password" id="coor-passcode-change" placeholder="Nou codi de seguretat..." class="w-full max-w-xs px-3 py-1.5 text-[11px] bg-white border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-indigo-500">
                        <button onclick="changePasscode()" class="px-3 py-1.5 text-[10px] font-bold bg-amber-600 hover:bg-amber-700 text-white rounded-lg transition-colors whitespace-nowrap">
                            Desar Codi
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alerta informativa de Desiderata -->
        <div id="info-banner" class="bg-gradient-to-r from-indigo-50 to-blue-50 border border-indigo-100 rounded-2xl p-5 mb-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-xs">
            <div class="flex items-start gap-3.5">
                <span class="p-2.5 bg-indigo-600/10 rounded-xl text-indigo-600 mt-0.5 md:mt-0">
                    <i class="fa-solid fa-circle-info text-lg"></i>
                </span>
                <div>
                    <h3 class="font-bold text-indigo-950 text-base">Període d'elecció actiu (Curs 2026-2027)</h3>
                    <p class="text-sm text-indigo-800/90 leading-relaxed mt-0.5">
                        Si us plau, tria els "globus" de matèries i grups que t'interessaria impartir. La teva jornada és <b>18 hores setmanals</b> (a no ser que demanis reducció). Has de triar les Coordinacions també:
                    </p>
                </div>
            </div>
            <div class="text-xs font-semibold bg-indigo-600 text-white px-4 py-2 rounded-full shadow-xs whitespace-nowrap self-stretch md:self-auto text-center">
                <i class="fa-solid fa-cloud-arrow-up mr-1"></i> Connexió dinàmica activa
            </div>
        </div>

        <!-- Filtre Dinàmic d'Estudis (Cicles) -->
        <div class="mb-6">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-2.5">Filtra per Cicle Formatiu / Especialitat / Càrrec</span>
            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2">
                <button onclick="setFilterStudy('all')" id="filter-study-all" class="filter-study-btn p-3 rounded-2xl border text-left transition-all duration-200 flex flex-col justify-between h-20 bg-indigo-600 text-white border-indigo-600 shadow-md">
                    <i class="fa-solid fa-border-all text-sm mb-1"></i>
                    <span class="text-xs font-bold leading-tight">Tots els cicles</span>
                </button>
                <button onclick="setFilterStudy('ac')" id="filter-study-ac" class="filter-study-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-indigo-300 text-slate-700 transition-all duration-200 flex flex-col justify-between h-20">
                    <i class="fa-solid fa-basket-shopping text-sm text-indigo-500 mb-1"></i>
                    <span class="text-xs font-bold leading-tight">CFGM Activitats Comercials</span>
                </button>
                <button onclick="setFilterStudy('mp')" id="filter-study-mp" class="filter-study-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-indigo-300 text-slate-700 transition-all duration-200 flex flex-col justify-between h-20">
                    <i class="fa-solid fa-lightbulb text-sm text-amber-500 mb-1"></i>
                    <span class="text-xs font-bold leading-tight">CFGS Màrqueting i Publicitat</span>
                </button>
                <button onclick="setFilterStudy('ci')" id="filter-study-ci" class="filter-study-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-indigo-300 text-slate-700 transition-all duration-200 flex flex-col justify-between h-20">
                    <i class="fa-solid fa-globe text-sm text-sky-500 mb-1"></i>
                    <span class="text-xs font-bold leading-tight">CFGS Comerç Internacional</span>
                </button>
                <button onclick="setFilterStudy('tl')" id="filter-study-tl" class="filter-study-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-indigo-300 text-slate-700 transition-all duration-200 flex flex-col justify-between h-20">
                    <i class="fa-solid fa-truck-fast text-sm text-emerald-500 mb-1"></i>
                    <span class="text-xs font-bold leading-tight">CFGS Transport i Logística</span>
                </button>
                <button onclick="setFilterStudy('ga')" id="filter-study-ga" class="filter-study-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-indigo-300 text-slate-700 transition-all duration-200 flex flex-col justify-between h-20">
                    <i class="fa-solid fa-calculator text-sm text-cyan-500 mb-1"></i>
                    <span class="text-xs font-bold leading-tight">CFGM Gestió Administrativa</span>
                </button>
                <button onclick="setFilterStudy('af')" id="filter-study-af" class="filter-study-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-indigo-300 text-slate-700 transition-all duration-200 flex flex-col justify-between h-20">
                    <i class="fa-solid fa-chart-pie text-sm text-fuchsia-500 mb-1"></i>
                    <span class="text-xs font-bold leading-tight">CFGS Administració i Finances</span>
                </button>
                <button onclick="setFilterStudy('coor')" id="filter-study-coor" class="filter-study-btn p-3 rounded-2xl border text-left bg-white border-slate-200 hover:border-indigo-300 text-slate-700 transition-all duration-200 flex flex-col justify-between h-20">
                    <i class="fa-solid fa-briefcase text-sm text-rose-500 mb-1"></i>
                    <span class="text-xs font-bold leading-tight">Coordinacions i Càrrecs</span>
                </button>
            </div>

            <!-- Sub-filtre dinàmic específic per separar Coordinacions i Càrrecs -->
            <div id="coor-subfilters" class="hidden mt-4 p-3.5 bg-slate-50 border border-slate-200/60 rounded-2xl items-center flex-wrap gap-1.5 animate-fadeIn">
                <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mr-2 ml-1">Tipus de Coordinació / Àrea</span>
                <button onclick="setCoorSubFilter('all')" id="coor-sub-all" class="coor-sub-btn px-3.5 py-1.5 text-[10px] font-bold rounded-xl bg-indigo-600 text-white transition-colors shadow-xs">Totes</button>
                <button onclick="setCoorSubFilter('com')" id="coor-sub-com" class="coor-sub-btn px-3.5 py-1.5 text-[10px] font-bold rounded-xl bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 transition-colors">Només Comerç i Màrqueting</button>
                <button onclick="setCoorSubFilter('adm')" id="coor-sub-adm" class="coor-sub-btn px-3.5 py-1.5 text-[10px] font-bold rounded-xl bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 transition-colors">Només Administració i Finances</button>
                <button onclick="setCoorSubFilter('gen')" id="coor-sub-gen" class="coor-sub-btn px-3.5 py-1.5 text-[10px] font-bold rounded-xl bg-white text-slate-600 border border-slate-200 hover:bg-slate-100 transition-colors">Generals / Centre</button>
            </div>
        </div>

        <!-- Secció de Propostes Rebudes (Visibles en Mode Edició) -->
        <div id="admin-proposals-section" class="hidden bg-white rounded-3xl border border-slate-200 shadow-xs p-6 mb-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-3 border-b border-slate-100 mb-4">
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-inbox text-indigo-600 text-lg"></i> 
                    <span>Propostes enviades pel professorat (Temps Real)</span>
                    <span id="proposal-count-badge" class="bg-indigo-100 text-indigo-700 text-xs font-extrabold px-3 py-1 rounded-full">0 propostes</span>
                </h2>
                
                <!-- Selectors de tipus de visualització de propostes -->
                <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl self-stretch sm:self-auto">
                    <button onclick="setViewType('cards')" id="btn-view-cards" class="flex-1 sm:flex-initial px-3.5 py-1.5 text-xs font-bold rounded-lg bg-indigo-600 text-white transition-all">
                        <i class="fa-solid fa-grip mr-1"></i> Targetes
                    </button>
                    <button onclick="setViewType('table')" id="btn-view-table" class="flex-1 sm:flex-initial px-3.5 py-1.5 text-xs font-bold rounded-lg text-slate-600 hover:text-slate-800 transition-all">
                        <i class="fa-solid fa-table-cells mr-1"></i> Taula (Excel)
                    </button>
                </div>
            </div>

            <!-- VISTA A: TARGETES (Per defecte) -->
            <div id="proposals-cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- S'omple des de Firestore/local -->
            </div>

            <!-- VISTA B: TAULA XLS (Oculta per defecte) -->
            <div id="proposals-table-container" class="hidden flex-col gap-4 animate-fadeIn">
                <div class="flex justify-between items-center bg-slate-50 p-3 rounded-2xl border border-slate-200/60">
                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Graella global d'assignació d'hores de desiderata</span>
                    <button onclick="copyTableToClipboard()" class="px-3 py-2 text-xs font-bold bg-slate-900 hover:bg-slate-800 text-white rounded-xl flex items-center gap-1.5 transition-colors shadow-xs">
                        <i class="fa-solid fa-copy"></i> Copiar Taula per a Excel/Sheets
                    </button>
                </div>
                
                <div class="overflow-x-auto border border-slate-200 rounded-2xl bg-white max-h-[450px]">
                    <table class="w-full text-left text-xs border-collapse" id="xls-export-table">
                        <thead class="bg-slate-50 text-slate-600 uppercase text-[10px] font-bold sticky top-0 border-b border-slate-200">
                            <tr>
                                <th class="p-3.5 border-r border-slate-200">Cicle Formatiu / Estudi</th>
                                <th class="p-3.5 border-r border-slate-200 text-center">Grup / Curs</th>
                                <th class="p-3.5 border-r border-slate-200 text-center">Codi Mòdul</th>
                                <th class="p-3.5 border-r border-slate-200">Nom de la Matèria o Càrrec</th>
                                <th class="p-3.5 border-r border-slate-200 text-center">Hores</th>
                                <th class="p-3.5 border-r border-slate-200">Docents que la demanen</th>
                                <th class="p-3.5 text-center">Docent Assignat Oficial (Edita)</th>
                            </tr>
                        </thead>
                        <tbody id="xls-table-body" class="divide-y divide-slate-100 text-slate-700">
                            <!-- S'omple dinàmicament compilellant les tries -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Graella de continguts -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- BLOC ESQUERRA: Filtres de curs / hores i llistat de globus -->
            <div class="lg:col-span-8 flex flex-col gap-5">
                
                <!-- Barra d'Eines i Filtres d'Hores / Curs -->
                <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex flex-col gap-4">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                        <!-- Cercador de text -->
                        <div class="relative w-full md:w-72">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                                <i class="fa-solid fa-magnifying-glass text-xs"></i>
                            </span>
                            <input type="text" id="search-input" oninput="filterDatabase()" placeholder="Cerca per mòdul, nom o docent..." class="w-full pl-9 pr-4 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-colors">
                        </div>
                        
                        <!-- Selectors de curs (1r / 2n) -->
                        <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl w-full md:w-auto overflow-x-auto">
                            <button onclick="setFilterCourse('all')" id="filter-course-all" class="filter-course-btn px-4 py-2 text-[11px] font-bold rounded-lg bg-indigo-600 text-white transition-all whitespace-nowrap">Tots els cursos</button>
                            <button onclick="setFilterCourse('1')" id="filter-course-1" class="filter-course-btn px-4 py-2 text-[11px] font-bold rounded-lg text-slate-600 hover:text-slate-800 transition-all whitespace-nowrap">1r Curs</button>
                            <button onclick="setFilterCourse('2')" id="filter-course-2" class="filter-course-btn px-4 py-2 text-[11px] font-bold rounded-lg text-slate-600 hover:text-slate-800 transition-all whitespace-nowrap">2n Curs</button>
                        </div>
                    </div>

                    <!-- Filtre ràpid de volum d'hores -->
                    <div class="flex items-center gap-1.5 justify-start overflow-x-auto pb-1 md:pb-0 border-t border-slate-100 pt-3">
                        <button onclick="setFilterHours('all')" id="filter-hours-all" class="filter-hours-btn px-3.5 py-2 text-[10px] font-bold rounded-xl bg-indigo-600 text-white transition-colors whitespace-nowrap">Totes les hores</button>
                        <button onclick="setFilterHours('short')" id="filter-hours-short" class="filter-hours-btn px-3.5 py-2 text-[10px] font-bold rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors whitespace-nowrap">Hores curtes (≤ 3h)</button>
                        <button onclick="setFilterHours('long')" id="filter-hours-long" class="filter-hours-btn px-3.5 py-2 text-[10px] font-bold rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors whitespace-nowrap">Hores completes (≥ 4h)</button>
                        <span class="h-6 w-px bg-slate-200 mx-1"></span>
                        <button onclick="setFilterStatus('all')" id="filter-status-all" class="filter-status-btn px-3.5 py-2 text-[10px] font-bold rounded-xl bg-slate-900 text-white transition-colors whitespace-nowrap">Tots els estats</button>
                        <button onclick="setFilterStatus('available')" id="filter-status-available" class="filter-status-btn px-3.5 py-2 text-[10px] font-bold rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors whitespace-nowrap">Lliures / Disponibles</button>
                    </div>
                </div>

                <!-- Llistat de Globus de matèries -->
                <div id="materies-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <!-- S'omple dinàmicament -->
                </div>
            </div>

            <!-- BLOC DRET: Panell lateral de tria d'hores acumulades -->
            <div class="lg:col-span-4 sticky top-24">
                <div class="bg-white rounded-3xl border border-slate-200 shadow-xs p-5">
