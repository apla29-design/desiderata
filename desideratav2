        // Connexió amb Firestore
        async function initFirebase() {
            if (!firebaseConfig) {
                console.warn("L'aplicació s'executa localment sense connexió.");
                return;
            }
            try {
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);
                
                if (initialAuthToken) {
                    await signInWithCustomToken(auth, initialAuthToken);
                } else {
                    await signInAnonymously(auth);
                }
                
                isFirebaseInitialized = true;
                listenToSubjects();
                listenToProposals();
            } catch (error) {
                console.error("Error al Firebase:", error);
            }
        }

        function listenToSubjects() {
            try {
                const subjectsCol = collection(db, 'artifacts', appId, 'public', 'data', 'subjects');
                onSnapshot(subjectsCol, (snapshot) => {
                    const loadedSubjects = [];
                    snapshot.forEach(doc => {
                        loadedSubjects.push({ id: doc.id, ...doc.data() });
                    });
                    
                    if (loadedSubjects.length === 0) {
                        initializeDefaultSubjectsInCloud();
                    } else {
                        database = loadedSubjects;
                        saveSubjectsLocally(); // Sincronitzem també en local per si es perd la xarxa
                        renderSubjectCards();
                        updateSelectionDashboard();
                        renderProposalsTable();
                    }
                }, (error) => {
                    console.error("Error de xarxa en rebre matèries:", error);
                });
            } catch (err) {
                console.warn("Firestore offline - usant persistència local de matèries.");
            }
        }

