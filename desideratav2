        function listenToProposals() {
            try {
                const proposalsCol = collection(db, 'artifacts', appId, 'public', 'data', 'proposals');
                onSnapshot(proposalsCol, (snapshot) => {
                    proposals = [];
                    snapshot.forEach(doc => {
                        proposals.push({ id: doc.id, ...doc.data() });
                    });
                    
                    const savedLocal = localStorage.getItem('mimo_local_proposals');
                    if (savedLocal) {
                        const locals = JSON.parse(savedLocal);
                        locals.forEach(localProp => {
                            if (!proposals.some(p => p.id === localProp.id)) {
                                proposals.push(localProp);
                            }
                        });
                    }
                    saveProposalsLocally();
                    renderProposalsList();
                    renderProposalsTable();
