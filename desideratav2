            );
        }

        async function submitPreferences() {
            if (selectedSubjects.length === 0) return;
            
            const teacherName = document.getElementById('user-display-name').innerText;
            const teacherSpec = document.getElementById('user-display-spec').innerText;
            
            let totalHours = 0;
            const subjectsNamesArray = [];
            const subjectsCodesArray = [];
            const subjectsIdsArray = [];

            selectedSubjects.forEach(id => {
                const data = database.find(item => item.id === id);
                if (data) {
                    totalHours += data.hours;
                    subjectsNamesArray.push(data.name);
                    subjectsCodesArray.push(data.code);
                    subjectsIdsArray.push(data.id);
                }
            });

            const proposalData = {
                teacherName: teacherName,
                teacherSpec: teacherSpec,
                selectedSubjectIds: subjectsIdsArray,
                selectedSubjectCodes: subjectsCodesArray,
                selectedSubjectNames: subjectsNamesArray,
                totalHours: totalHours,
                timestamp: Date.now()
            };

            const webhookUrl = document.getElementById('sheets-webhook-url').value.trim();
            if (webhookUrl) {
                try {
                    fetch(webhookUrl, {
                        method: 'POST',
                        mode: 'no-cors', 
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(proposalData)
                    });
                } catch (webhookErr) {
                    console.warn("No s'ha pogut transmetre automàticament a Google Drive:", webhookErr);
                }
            }

            if (isFirebaseInitialized) {
                try {
                    const proposalsCol = collection(db, 'artifacts', appId, 'public', 'data', 'proposals');
                    await addDoc(proposalsCol, proposalData);
                    
                    const successModal = document.getElementById('success-modal');
                    if (successModal) successModal.classList.remove('hidden');
                } catch (error) {
                    console.error("Error enviant proposta:", error);
                }
            } else {
                const newProposal = {
                    id: 'local_' + Date.now(),
                    teacherName: teacherName,
                    teacherSpec: teacherSpec,
                    selectedSubjectIds: [...selectedSubjects],
                    totalHours: totalHours,
                    timestamp: Date.now()
                };

                proposals.push(newProposal);
                saveProposalsLocally(); // <-- Guarda de manera permanent la proposta del professor en local!
                
                renderProposalsList();
                renderProposalsTable();

                const successModal = document.getElementById('success-modal');
                if (successModal) successModal.classList.remove('hidden');
            }
        }

