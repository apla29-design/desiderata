function doGet(e) {
  return ContentService.createTextOutput("Connexió correcta! El servidor d'integració de l'INS Jaume Mimó està actiu i escoltant peticions al núvol. No et preocupis, aquest missatge confirma que has fet la implementació a la perfecció. Ara ja pots enviar la teva tria des del selector de matèries de la web!")
    .setMimeType(ContentService.MimeType.TEXT);
}

function doPost(e) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getActiveSheet(); // Full principal de treball
    var data = JSON.parse(e.postData.contents);
    
    var teacherName = data.teacherName;
    var teacherSpec = data.teacherSpec;
    var selectedCodes = data.selectedSubjectCodes || []; // Codis de matèria demanats
    var selectedIds = data.selectedSubjectIds || [];     // IDs de matèria demanats
    var selectedNames = data.selectedSubjectNames || []; // Noms de matèria demanats
    
    var lastRow = sheet.getLastRow();
    var matchedIndices = []; // Desa quins mòduls de la tria s'han localitzat i assignat al full principal
    
    if (lastRow >= 2) {
      var range = sheet.getRange(1, 1, lastRow, sheet.getLastColumn());
      var values = range.getValues();
      
      // Escanegem cada fila del teu full per buscar coincidències amb el mòdul o càrrec
      for (var i = 1; i < values.length; i++) {
        var row = values[i];
        var matchFoundIdx = -1;
        
        // Comprovem si alguna de les cel·les coincideix amb el codi, ID o Nom de la matèria triada
        for (var colIdx = 0; colIdx < row.length; colIdx++) {
          var cellValue = String(row[colIdx]).trim();
          if (!cellValue) continue;
          
          for (var k = 0; k < selectedIds.length; k++) {
            if (cellValue === selectedIds[k] || 
                cellValue === selectedCodes[k] || 
                cellValue === selectedNames[k]) {
              matchFoundIdx = k;
              break;
            }
          }
          if (matchFoundIdx !== -1) break;
        }
        
        // Si detecta coincidència, escriu el nom del docent directament a la Columna J (Columna 10)
        if (matchFoundIdx !== -1) {
          sheet.getRange(i + 1, 10).setValue(teacherName); 
          if (matchedIndices.indexOf(matchFoundIdx) === -1) {
            matchedIndices.push(matchFoundIdx);
          }
        }
      }
    }
    
    // Gestió del "Full IA" (actua com a registre de seguretat absolut per a l'ordre d'arribada)
    var iaSheet = ss.getSheetByName("Full IA");
    if (!iaSheet) {
      iaSheet = ss.insertSheet("Full IA");
      iaSheet.appendRow(["Num. Registre", "Data i Hora", "Nom Docent", "Especialitat", "Element triat (Codi/Nom)", "Estat Sincronització", "Detalls / Observacions"]);
      iaSheet.getRange("A1:G1").setBackground("#cbd5e1").setFontWeight("bold").setHorizontalAlignment("center");
    }
    
    // Escrivim ABSOLUTAMENT TOTES les matèries triades al "Full IA" per mantenir el control perfecte cronològic
    for (var m = 0; m < selectedIds.length; m++) {
      var isMatched = matchedIndices.indexOf(m) !== -1;
      var status = isMatched ? "Sincronitzat correctament a la Columna J" : "Pendent - No trobat al full principal";
      var instruction = isMatched ? 
        "L'element s'ha enllaçat amb èxit a la llista d'assignació directa." : 
        "S'ha desat el registre d'elecció. Revisa si el codi d'aquest càrrec o mòdul coincideix exactament al teu full principal.";
      
      var nextRegNum = iaSheet.getLastRow(); // Comptador correlatiu
      
      iaSheet.appendRow([
        nextRegNum,
        new Date(),
        teacherName,
        teacherSpec,
        selectedCodes[m] + " - " + selectedNames[m],
        status,
        instruction
      ]);
    }
    
    return ContentService.createTextOutput("Sincronització Correcta").setMimeType(ContentService.MimeType.TEXT);
  } catch (err) {
    return ContentService.createTextOutput("Error: " + err.toString()).setMimeType(ContentService.MimeType.TEXT);
  }
}</pre>
