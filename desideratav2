        function updateSelectionDashboard() {
            const listContainer = document.getElementById('selected-list');
            const emptyMsg = document.getElementById('empty-selection-msg');
            const countBadge = document.getElementById('selected-count-badge');
            const totalHoursEl = document.getElementById('total-hours');
            const progressBar = document.getElementById('progress-bar');
            const statusText = document.getElementById('hours-status-text');
            const submitBtn = document.getElementById('btn-submit');
            
            if (!listContainer) return;
            const currentRows = listContainer.querySelectorAll('.selected-item-row');
            currentRows.forEach(el => el.remove());
            
            let hoursSum = 0;
            
            if (selectedSubjects.length === 0) {
                if (emptyMsg) emptyMsg.classList.remove('hidden');
                if (countBadge) countBadge.innerText = '0 mòduls';
            } else {
                if (emptyMsg) emptyMsg.classList.add('hidden');
                if (countBadge) countBadge.innerText = `${selectedSubjects.length} mòdul${selectedSubjects.length > 1 ? 's' : ''}`;
                
                selectedSubjects.forEach(id => {
                    const data = database.find(item => item.id === id);
                    if (!data) return; 
                    
                    hoursSum += data.hours;
                    
                    const row = document.createElement('div');
                    row.className = 'selected-item-row bg-slate-50 border border-slate-100 p-3 rounded-2xl flex items-center justify-between gap-3 shadow-xs animate-fadeIn';
                    row.innerHTML = `
                        <div class="min-w-0 flex-grow">
                            <span class="text-[9px] font-bold text-slate-400 block uppercase">${data.cycle} (Codi ${data.code})</span>
                            <h4 class="text-[11px] font-extrabold text-slate-800 truncate">${data.name}</h4>
                            <p class="text-[9px] text-slate-500 font-bold">${data.group}</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-[11px] font-extrabold text-indigo-700 bg-indigo-50 border border-indigo-100/50 px-2 py-0.5 rounded-lg">${data.hours}h</span>
                            <button onclick="toggleSelectSubject('${id}')" class="text-slate-400 hover:text-rose-600 transition-colors">
                                <i class="fa-regular fa-circle-xmark text-sm"></i>
                            </button>
                        </div>
                    `;
                    listContainer.appendChild(row);
                });
            }
            
            if (totalHoursEl) totalHoursEl.innerHTML = `${hoursSum}h <span class="text-xs text-slate-400 font-medium">/ 18h requerides</span>`;
            const percent = Math.min((hoursSum / 18) * 100, 100);
            if (progressBar) progressBar.style.width = `${percent}%`;
            
            if (hoursSum === 0) {
                if (statusText) {
                    statusText.innerText = 'No has seleccionat cap element encara.';
                    statusText.className = 'text-[10px] font-bold text-slate-400';
                }
                if (progressBar) progressBar.className = 'bg-slate-200 h-full';
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.className = 'w-full py-3.5 px-4 rounded-2xl font-bold text-xs bg-slate-200 text-slate-400 cursor-not-allowed transition-all flex items-center justify-center gap-2';
                }
            } else if (hoursSum < 18) {
                if (statusText) {
                    statusText.innerText = 'Menys de 18h. Pots enviar la proposta si tens reducció d\'horari.';
                    statusText.className = 'text-[10px] font-bold text-amber-600';
                }
                if (progressBar) progressBar.className = 'bg-amber-500 h-full rounded-full transition-all duration-500';
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.className = 'w-full py-3.5 px-4 rounded-2xl font-bold text-xs bg-indigo-600 hover:bg-indigo-700 text-white shadow-md cursor-pointer transition-all flex items-center justify-center gap-2';
                }
            } else if (hoursSum === 18) {
                if (statusText) {
                    statusText.innerText = 'Jornada òptima de 18h completa!';
                    statusText.className = 'text-[10px] font-bold text-emerald-600';
                }
                if (progressBar) progressBar.className = 'bg-emerald-500 h-full rounded-full transition-all duration-500';
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.className = 'w-full py-3.5 px-4 rounded-2xl font-bold text-xs bg-indigo-600 hover:bg-indigo-700 text-white shadow-md shadow-indigo-600/10 hover:shadow-indigo-600/20 cursor-pointer transition-all flex items-center justify-center gap-2';
                }
            } else {
                if (statusText) {
                    statusText.innerText = 'Has superat les 18 hores de referència. Pots enviar-la de totes maneres.';
                    statusText.className = 'text-[10px] font-bold text-rose-600';
                }
                if (progressBar) progressBar.className = 'bg-rose-500 h-full rounded-full transition-all duration-500';
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.className = 'w-full py-3.5 px-4 rounded-2xl font-bold text-xs bg-indigo-600 hover:bg-indigo-700 text-white shadow-md cursor-pointer transition-all flex items-center justify-center gap-2';
                }
            }
        }

